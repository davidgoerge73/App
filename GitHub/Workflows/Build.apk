name: Build Android APK

on:
  push:
    branches: [ main, master ]
  workflow_dispatch:

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
    - name: Checkout Code
      uses: actions/checkout@v4

    # 1. إعداد لغة Python
    - name: Set up Python
      uses: actions/setup-python@v5
      with:
        python-version: '3.10'

    # 2. إعداد وإجبار استخدام Java 17
    - name: Set up JDK 17
      uses: actions/setup-java@v4
      with:
        distribution: 'temurin'
        java-version: '17'

    # 3. تثبيت الاعتمادات والأدوات المطلوبة
    - name: Install System Dependencies & Buildozer
      run: |
        sudo apt update
        sudo apt install -y git zip unzip autoconf libtool pkg-config zlib1g-dev libncurses5-dev libncursesw5-dev libtinfo5 cmake libffi-dev libssl-dev
        pip install --upgrade pip buildozer Cython

    # 4. قبول جميع تراخيص Android SDK تلقائيًا وتحضير البيئة
    - name: Accept Android SDK Licenses & Prepare Spec
      run: |
        # الموافقة التلقائية على تراخيص أندرويد
        mkdir -p ~/.android
        touch ~/.android/repositories.cfg
        yes | sdkmanager --licenses || true

        # إنشاء ملف buildozer.spec إذا لم يكن موجودًا
        if [ ! -f buildozer.spec ]; then
          buildozer init
        fi

    # 5. البدء المباشر لتجميع الـ APK
    - name: Build APK with Buildozer
      run: |
        buildozer -v android debug

    # 6. استخراج وتوفير ملف الـ APK للتحميل
    - name: Upload APK Artifact
      uses: actions/upload-artifact@v4
      with:
        name: Kivy-App-APK
        path: bin/*.apk
